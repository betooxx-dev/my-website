# Local development defaults are shown here. Production URLs must use HTTPS.
ARGOS_API_URL=http://localhost:5000/api
NEXT_PUBLIC_ARGOS_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production. Never reuse these placeholders.
STUDIO_ARGOS_API_KEY=replace-with-blog-admin-api-key
STUDIO_USERNAME=studio
STUDIO_PASSWORD_HASH=scrypt:replace-with-random-salt:replace-with-base64url-hash
STUDIO_SESSION_SECRET=replace-with-at-least-32-random-characters
