{
  "name": "my-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "simple-git-hooks"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "simple-git-hooks": {
    "pre-commit": "docker compose run --rm --no-deps -e NODE_ENV=test web sh -lc 'npm run lint && npm run typecheck && npm test -- --runInBand'"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.18",
    "@t3-oss/env-nextjs": "^0.13.10",
    "axios": "^1.13.6",
    "framer-motion": "^12.34.3",
    "next": "16.2.11",
    "next-intl": "^4.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jest": "^30.3.0",
    "jest-environment-node": "^30.3.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
