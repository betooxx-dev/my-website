# Copy this file to .env.production.
# TODO: Uncomment when the Argos backend and final domain are deployed.
# Public URLs are embedded in the browser bundle during `docker compose build`.
# ARGOS_API_URL=https://api.example.com/api
# NEXT_PUBLIC_ARGOS_API_URL=https://api.example.com/api
# NEXT_PUBLIC_SITE_URL=https://example.com
NODE_ENV=production

# TODO: Uncomment with real secrets when the Argos backend is deployed.
# Never commit the real values.
# STUDIO_ARGOS_API_KEY=generate-a-dedicated-argos-blog-admin-key
# STUDIO_USERNAME=studio
# STUDIO_PASSWORD_HASH=scrypt:replace-with-random-salt:replace-with-base64url-hash
# STUDIO_SESSION_SECRET=replace-with-at-least-32-random-characters
